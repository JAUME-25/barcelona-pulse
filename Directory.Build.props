<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Necesario para que IDE0005 (usings sobrantes) se compruebe al compilar. En la API,
         además, los comentarios XML pasan a las descripciones del documento OpenAPI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Todo lo compilado va a artifacts/. En el contenedor de herramientas,
         ArtifactsPath apunta a un volumen y no toca el árbol de trabajo. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>
</Project>
