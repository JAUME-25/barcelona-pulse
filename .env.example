# Copia este archivo a .env (cp .env.example .env). .env no se versiona.
# Valores solo para el entorno local de Docker Compose.

POSTGRES_DB=barcelona_pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=cambia-esta-clave-local

# Puertos publicados en 127.0.0.1
DB_PORT=55432
API_PORT=5080

# Orígenes permitidos por CORS (separados por coma). En local, Vite usa proxy y no lo necesita.
CORS_ALLOWED_ORIGINS=http://localhost:5173
