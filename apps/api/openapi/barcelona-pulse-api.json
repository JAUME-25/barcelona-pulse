{
  "openapi": "3.1.1",
  "info": {
    "title": "Barcelona Pulse API",
    "description": "Estaciones de Bicing y su estado. Distingue datos observados de datos sintéticos de demostración.",
    "version": "v1"
  },
  "paths": {
    "/api/sources": {
      "get": {
        "tags": [
          "Sources"
        ],
        "summary": "Fuentes de datos, su tipo (observada o sintética) y el periodo que cubren",
        "operationId": "ListSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}/timeline": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Línea temporal de una fuente: estaciones con dato y totales en cada paso",
        "description": "Aplica en cada paso la misma regla que GET /api/stations: última observación ≤ instante dentro de la tolerancia. Los huecos se ven como pasos con menos estaciones con dato. Máximo 7 días por petición.",
        "operationId": "GetTimeline",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador de la fuente.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Inicio ISO 8601 con zona. Sin from ni to: las últimas 24 h con datos de la fuente.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Fin ISO 8601 con zona (incluido).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "query",
            "description": "Paso en minutos: 5, 10, 15, 30 o 60. Por defecto, 5.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "tags": [
          "Stations"
        ],
        "summary": "Estaciones de una fuente y su estado en un instante",
        "description": "Devuelve la versión vigente de cada estación y su última observación anterior o igual a `at`. Fuera de la tolerancia de la fuente el estado es `unknown` y los recuentos son nulos.",
        "operationId": "ListStations",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "description": "Obligatorio. Identificador de la fuente (ver GET /api/sources).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "description": "Opcional. Zona minLon,minLat,maxLon,maxLat en grados WGS84 (máximo 1° de lado).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "at",
            "in": "query",
            "description": "Opcional. Instante ISO 8601 con zona explícita. Sin él: fuente sintética, final de sus datos; fuente observada, ahora. La respuesta lo indica en atBasis.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/stations/{id}": {
      "get": {
        "tags": [
          "Stations"
        ],
        "summary": "Una estación, su estado en un instante y sus versiones",
        "operationId": "GetStation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identificador interno de la estación.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "at",
            "in": "query",
            "description": "Opcional. Instante ISO 8601 con zona explícita. Sin él: fuente sintética, final de sus datos; fuente observada, ahora. La respuesta lo indica en atBasis.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Freshness": {
        "enum": [
          "current",
          "stale",
          "none"
        ],
        "description": "Frescura del dato en el instante consultado."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IngestionStatus": {
        "enum": [
          "running",
          "succeeded",
          "succeeded_with_issues",
          "failed"
        ]
      },
      "InstantBasis": {
        "enum": [
          "requested",
          "latest_observation",
          "now"
        ],
        "description": "Cómo se eligió el instante de la respuesta."
      },
      "LastIngestionSummary": {
        "required": [
          "startedAt",
          "finishedAt",
          "status",
          "observationsAccepted",
          "observationsDuplicate",
          "observationsConflicting",
          "observationsRejected"
        ],
        "type": "object",
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/IngestionStatus"
          },
          "observationsAccepted": {
            "type": "integer",
            "format": "int32"
          },
          "observationsDuplicate": {
            "type": "integer",
            "format": "int32"
          },
          "observationsConflicting": {
            "type": "integer",
            "format": "int32"
          },
          "observationsRejected": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ObservationPeriod": {
        "required": [
          "from",
          "to",
          "observationCount"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "observationCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ObservationStatus": {
        "enum": [
          "in_service",
          "maintenance",
          "closed",
          "planned",
          "unknown"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourceKind": {
        "enum": [
          "observed",
          "synthetic"
        ]
      },
      "SourceRef": {
        "required": [
          "id",
          "kind",
          "name",
          "attribution",
          "license",
          "url"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "name": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "license": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourceSummary": {
        "required": [
          "id",
          "kind",
          "name",
          "attribution",
          "license",
          "url",
          "toleranceMinutes",
          "stationCount",
          "period",
          "lastIngestion"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SourceKind"
          },
          "name": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "license": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "toleranceMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "stationCount": {
            "type": "integer",
            "format": "int32"
          },
          "period": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ObservationPeriod"
              }
            ]
          },
          "lastIngestion": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LastIngestionSummary"
              }
            ]
          }
        },
        "description": "Fuente disponible, con el periodo realmente cubierto por sus observaciones."
      },
      "StationDetailResponse": {
        "required": [
          "source",
          "at",
          "atBasis",
          "toleranceMinutes",
          "station",
          "versions"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "atBasis": {
            "$ref": "#/components/schemas/InstantBasis"
          },
          "toleranceMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "station": {
            "$ref": "#/components/schemas/StationItem"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationVersionItem"
            }
          }
        }
      },
      "StationItem": {
        "required": [
          "id",
          "sourceStationId",
          "name",
          "address",
          "district",
          "neighbourhood",
          "longitude",
          "latitude",
          "capacity",
          "metadataAssumed",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador interno, estable dentro de esta base de datos.",
            "format": "int64"
          },
          "sourceStationId": {
            "type": "string",
            "description": "Identificador tal como lo publica la fuente."
          },
          "name": {
            "type": "string",
            "description": "Nombre publicado por la fuente."
          },
          "address": {
            "type": [
              "null",
              "string"
            ],
            "description": "Dirección, si la fuente la publica."
          },
          "district": {
            "type": [
              "null",
              "string"
            ],
            "description": "Distrito, si la fuente lo publica."
          },
          "neighbourhood": {
            "type": [
              "null",
              "string"
            ],
            "description": "Barrio, si la fuente lo publica."
          },
          "longitude": {
            "type": "number",
            "description": "Longitud WGS84.",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "description": "Latitud WGS84.",
            "format": "double"
          },
          "capacity": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Capacidad publicada; nula si la fuente no la da.",
            "format": "int32"
          },
          "metadataAssumed": {
            "type": "boolean",
            "description": "Los atributos se publicaron después del instante consultado y se asumen vigentes\ntambién antes (primera versión conocida)."
          },
          "state": {
            "description": "Estado en el instante consultado.",
            "$ref": "#/components/schemas/StationState"
          }
        },
        "description": "Estación con sus atributos vigentes en el instante consultado."
      },
      "StationsResponse": {
        "required": [
          "source",
          "at",
          "atBasis",
          "toleranceMinutes",
          "count",
          "truncated",
          "stations"
        ],
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/SourceRef"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "atBasis": {
            "$ref": "#/components/schemas/InstantBasis"
          },
          "toleranceMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "truncated": {
            "type": "boolean"
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationItem"
            }
          }
        }
      },
      "StationState": {
        "required": [
          "freshness",
          "lastObservedAt",
          "status",
          "bikesAvailable",
          "mechanicalBikesAvailable",
          "ebikesAvailable",
          "docksAvailable",
          "bikesDisabled",
          "docksDisabled",
          "isRenting",
          "isReturning",
          "qualityFlags"
        ],
        "type": "object",
        "properties": {
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "lastObservedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ObservationStatus"
          },
          "bikesAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "mechanicalBikesAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "ebikesAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "docksAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "bikesDisabled": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "docksDisabled": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "isRenting": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isReturning": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "qualityFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Estado en el instante consultado. Si la frescura no es `current`, el estado es\n`unknown` y los recuentos son nulos: falta de dato no es cero."
      },
      "StationVersionItem": {
        "required": [
          "name",
          "address",
          "district",
          "neighbourhood",
          "longitude",
          "latitude",
          "capacity",
          "validFrom",
          "validTo",
          "firstSeenAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "district": {
            "type": [
              "null",
              "string"
            ]
          },
          "neighbourhood": {
            "type": [
              "null",
              "string"
            ]
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "validFrom": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "validTo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TimelinePoint": {
        "required": [
          "at",
          "stationsKnown",
          "stationsWithData",
          "stationsCounted",
          "stationsEmpty",
          "stationsFull",
          "bikesAvailable",
          "docksAvailable"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "description": "Instante (UTC) del paso.",
            "format": "date-time"
          },
          "stationsKnown": {
            "type": "integer",
            "description": "Estaciones con atributos vigentes en ese instante.",
            "format": "int32"
          },
          "stationsWithData": {
            "type": "integer",
            "description": "Estaciones con observación dentro de la tolerancia (misma regla que el mapa).",
            "format": "int32"
          },
          "stationsCounted": {
            "type": "integer",
            "description": "De ellas, las operativas con los dos recuentos: las que se suman.",
            "format": "int32"
          },
          "stationsEmpty": {
            "type": "integer",
            "description": "Operativas sin bicis.",
            "format": "int32"
          },
          "stationsFull": {
            "type": "integer",
            "description": "Operativas con bicis y sin anclajes libres.",
            "format": "int32"
          },
          "bikesAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Bicis disponibles en las estaciones contadas; nula si no se cuenta ninguna.",
            "format": "int32"
          },
          "docksAvailable": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Anclajes libres en las estaciones contadas; nula si no se cuenta ninguna.",
            "format": "int32"
          }
        },
        "description": "Un instante de la línea temporal: cuántas estaciones tienen dato, cuántas están vacías o\nllenas y qué suman. Operativa: en servicio y prestando o admitiendo devoluciones; es la misma\nprecedencia que la leyenda de la web (`availability.ts`)."
      },
      "TimelineResponse": {
        "required": [
          "source",
          "from",
          "to",
          "stepMinutes",
          "toleranceMinutes",
          "points"
        ],
        "type": "object",
        "properties": {
          "source": {
            "description": "Fuente consultada, con su tipo.",
            "$ref": "#/components/schemas/SourceRef"
          },
          "from": {
            "type": "string",
            "description": "Primer paso, alineado a la rejilla (UTC).",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "description": "Último paso, alineado a la rejilla (UTC).",
            "format": "date-time"
          },
          "stepMinutes": {
            "type": "integer",
            "description": "Minutos entre pasos.",
            "format": "int32"
          },
          "toleranceMinutes": {
            "type": "integer",
            "description": "Antigüedad máxima de una observación para contar como dato.",
            "format": "int32"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelinePoint"
            },
            "description": "Un punto por paso, de From a To."
          }
        },
        "description": "Línea temporal de una fuente."
      }
    }
  },
  "tags": [
    {
      "name": "Sources"
    },
    {
      "name": "History"
    },
    {
      "name": "Stations"
    }
  ]
}